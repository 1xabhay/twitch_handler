# Copy to .env and fill in. Never commit .env.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000
# your channel login, and the bot account login (can be the same)
TWITCH_CHANNEL=
TWITCH_BOT=

# Optional: city coordinates so the town sky follows the real sun
SUN_LAT=
SUN_LON=

# Optional: theme days for the pixel city, theme:days;theme:days (days = sun..sat or MM-DD). Mods: !theme <name>|off|auto
THEMES=onepiece:fri,05-05,07-22
# Anime room backdrop kept fresh while OBS runs (launcher starts it): make room-watch NAME=<this>, see docs/SETUP.md
ROOM=

# Optional: Spotify song requests (see docs/MUSIC.md)
SPOTIFY_CLIENT_ID=
SPOTIFY_PLAYLIST=
MUSIC_ALLOW=StreamBeats,NCS
MUSIC_ALLOW_ALL=false

# Optional: link commands (!discord !insta !playlist !socials) and Discord go-live post
LINK_DISCORD=
LINK_INSTA=
LINK_PLAYLIST=
DISCORD_WEBHOOK=

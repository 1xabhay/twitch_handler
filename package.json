{
  "name": "twitch_handler",
  "version": "1.0.0",
  "description": "Cozy Twitch co-working bot + pixel-city OBS overlay, with community themes",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run --exclude '.claude/**'",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env src/main.ts",
    "preview": "node scripts/preview.ts",
    "login": "sh scripts/login.sh",
    "rewards:check": "node --env-file=.env scripts/rewards-check.ts",
    "login:spotify": "node --env-file=.env scripts/spotify-login.ts",
    "launcher": "sh scripts/make-launcher.sh",
    "room": "node --env-file-if-exists=.env scripts/room.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/suncalc": "^1.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "suncalc": "^1.9.0"
  }
}
